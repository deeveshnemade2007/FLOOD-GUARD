PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with automatic resilient storage fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flood_safe
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Weather API (Open-Meteo Pune Coordinates: 18.5204, 73.8567)
PUNE_LAT=18.5204
PUNE_LNG=73.8567
WEATHER_POLL_INTERVAL_SEC=60

# Simulation Configuration
SIMULATION_TICK_MS=3000

# WhatsApp / Twilio Alert Configuration (Simulated by default)
TWILIO_ACCOUNT_SID=mock_sid
TWILIO_AUTH_TOKEN=mock_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# PMC Authority PIN for Manual Override
AUTHORITY_OVERRIDE_PIN=PMC_PUNE_2026
